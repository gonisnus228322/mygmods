"VertexLitGeneric"
{
    "$basetexture" "models/gentoi/walterfiles/nosey/CasingNOSY"
    "$bumpmap"     "models/gentoi/walterfiles/nosey/casingnormal"
    "$nodecal" "1"
    "$phong" "1"
    "$phongboost"    "0.5"
    "$phongexponent" "5"
    "$phongfresnelranges"    "[0.1 0.23 0.945]"
    "$phongdisablehalflambert"    "1"
    "$color2" "[1 1 1]"

    "$envmap" "env_cubemap"
    "$normalmapalphaenvmapmask"        "1"
    "$envmapfresnel"    "1"

    "$envmaptint"        0
$nocull 1
}